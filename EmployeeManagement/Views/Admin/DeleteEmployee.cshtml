@model EmployeeManagement.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">

    <h2>Delete Employee</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this employee?
        This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Employee ID</dt>
        <dd class="col-sm-9">@Model.EmployeeId</dd>

        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>

        <dt class="col-sm-3">Designation</dt>
        <dd class="col-sm-9">@Model.Designation</dd>
    </dl>

    <form asp-controller="Admin"
          asp-action="DeleteEmployee"
          method="post">

        <input type="hidden"
               name="id"
               value="@Model.EmployeeId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-controller="Admin"
           asp-action="Employees"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
