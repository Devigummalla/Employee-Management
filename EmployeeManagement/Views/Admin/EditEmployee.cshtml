@model EmployeeManagement.Models.EmployeeEditViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-4">

    <h2>Edit Employee</h2>
    <p>Update employee information.</p>

    <form asp-controller="Admin"
          asp-action="EditEmployee"
          method="post">

        <input type="hidden" asp-for="EmployeeId" />

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Department" class="form-label"></label>
            <input asp-for="Department" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Designation" class="form-label"></label>
            <input asp-for="Designation" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="JoiningDate" class="form-label"></label>
            <input asp-for="JoiningDate"
                   type="date"
                   class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">
                Active Employee
            </label>
        </div>
        <div class="mb-3">
            <label asp-for="ConfidentialNotes" class="form-label">
                Confidential Notes
            </label>

            <textarea asp-for="ConfidentialNotes"
                      class="form-control"
                      rows="4"
                      placeholder="Enter replacement confidential notes">
    </textarea>

            <span asp-validation-for="ConfidentialNotes"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-controller="Admin"
           asp-action="Employees"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
