@model IEnumerable<EmployeeManagement.Models.Employee>

@{
    ViewData["Title"] = "Employee Directory";
}

<div class="container mt-4">

    <h2>Employee Directory</h2>
    <p>View all registered employees.</p>

    <!-- Employee Search -->
    <form asp-controller="Admin" asp-action="Employees" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name, email or department..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Admin"
               asp-action="Employees"
               class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No employee records found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td>@employee.EmployeeId</td>
                            <td>@employee.FullName</td>
                            <td>@employee.Email</td>
                            <td>@(employee.Department ?? "Not assigned")</td>
                            <td>@(employee.Designation ?? "Not assigned")</td>
                            <td>
                                @(employee.IsActive ? "Active" : "Inactive")
                            </td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditEmployee"
                                   asp-route-id="@employee.EmployeeId"
                                   class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <a asp-controller="Admin"
                                   asp-action="DeleteEmployee"
                                   asp-route-id="@employee.EmployeeId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>
